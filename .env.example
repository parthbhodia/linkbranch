NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Required for permanent account deletion.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional. GA4 measurement id (G-XXXXXXXXXX). The tag only loads when this is
# set, so leaving it blank keeps Google off local and preview builds.
NEXT_PUBLIC_GA_ID=
