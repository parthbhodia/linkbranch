NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Required for permanent account deletion.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Comma-separated addresses allowed to open /admin. Unset admits nobody, so
# the page fails closed rather than open. Kept out of the source because this
# repository is public.
ADMIN_EMAILS=

# Optional. GA4 measurement id (G-XXXXXXXXXX). The tag only loads when this is
# set, so leaving it blank keeps Google off local and preview builds.
NEXT_PUBLIC_GA_ID=

# Optional, server-only. Apple Wallet pass signing. Leave every value blank and
# the /card Wallet button is hidden and /api/wallet 404s -- nothing else
# changes, which is the intended state locally and on previews.
#
# PEMs are base64-encoded because they are multi-line and env vars are not:
#   base64 -w0 signerCert.pem
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_SIGNER_CERT_BASE64=
APPLE_PASS_SIGNER_KEY_BASE64=
APPLE_PASS_SIGNER_KEY_PASSPHRASE=
# Must be the G4 intermediate. G2, G3, G5 and G6 all fail validation.
APPLE_WWDR_CERT_BASE64=

# Google One Tap. Without it the prompt simply never appears; the
# Google button in the auth form keeps working either way.
# The same OAuth client as Google sign-in, but its *Authorized
# JavaScript origins* must list your domain -- One Tap runs in the page
# rather than redirecting, so the redirect URI alone is not enough.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
